rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function isAppOwner() { return signedIn() && request.auth.uid == 'NiZxyuiR2Dc1hQDOVCyXBGS2ax23'; }

    // Your private data: settings, decks, events and the game in progress. Only you can read or write it.
    match /users/{uid}/{document=**} {
      allow read, write: if me(uid);
    }

    // Friend codes: first come, first served, and permanent. "joey-220" is reserved for the app's owner.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && code.matches('^[a-z][a-z0-9]{1,15}-[0-9]{3,4}$')
        && (code != 'joey-220' || isAppOwner());
      allow update, delete: if false;
    }

    // Public profile: just your display name, friend code and photo, so friends can find you.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if me(uid)
        && request.resource.data.keys().hasOnly(['name', 'code', 'photo', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid;
      allow update: if me(uid)
        && request.resource.data.code == resource.data.code
        && request.resource.data.keys().hasOnly(['name', 'code', 'photo', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow delete: if false;
    }

    // Games: one record per game. Only the accounts in its players list can see it (for now, just whoever logged it;
    // friends get added in Phase 5, and a game only counts for them once they accept it).
    function isPlayerIn(data) { return signedIn() && request.auth.uid in data.players; }
    function gameDoc(gameId) { return get(/databases/$(database)/documents/games/$(gameId)).data; }
    match /games/{gameId} {
      allow read: if isPlayerIn(resource.data);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.players is list
        && request.auth.uid in request.resource.data.players
        && request.resource.data.players.size() <= 8
        && request.resource.data.accepted.keys().hasOnly([request.auth.uid])
        && request.resource.data.locked == false
        && request.resource.data.deleted == false
        && request.resource.data.seats is list && request.resource.data.seats.size() <= 8;
      // Anyone who played can edit. Only the app's owner can change who played or lock a game, and a locked game
      // can only be changed by the owner. You can only accept for yourself.
      allow update: if isPlayerIn(resource.data)
        && (resource.data.locked == false || isAppOwner())
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.players == resource.data.players || isAppOwner())
        && (request.resource.data.locked == resource.data.locked || isAppOwner())
        && request.resource.data.accepted.diff(resource.data.accepted).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.seats is list && request.resource.data.seats.size() <= 8;
      // Games are never erased: "Delete" hides them, so they can be restored.
      allow delete: if false;

      // Every edit keeps the version before it. Players add to the history; only the app's owner can read it.
      match /history/{historyId} {
        allow read: if isAppOwner() && request.auth.uid in gameDoc(gameId).players;
        allow create: if signedIn() && request.auth.uid in gameDoc(gameId).players
          && request.resource.data.savedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Playgroups (Phase 5a). Members can see their playgroup. Only admins change it (the organizer, who made it,
    // is always one); a member can only take themselves out. Only the organizer can delete it.
    function groupAt(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data; }
    function groupAfter(gid) { return getAfter(/databases/$(database)/documents/groups/$(gid)).data; }
    function isMemberOf(g) { return signedIn() && request.auth.uid in g.members; }
    function isAdminOf(g) { return signedIn() && request.auth.uid in g.admins; }
    function groupOk(d) {
      return d.keys().hasOnly(['name', 'createdBy', 'createdAt', 'updatedAt', 'members', 'admins', 'invite', 'inviteOn'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.members is list && d.members.size() <= 50
        && d.admins is list && d.members.hasAll(d.admins) && d.admins.hasAll([d.createdBy])
        && d.invite is string && d.inviteOn is bool;
    }
    match /groups/{gid} {
      allow read: if isMemberOf(resource.data);
      allow create: if signedIn() && groupOk(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.admins == [request.auth.uid];
      allow update: if groupOk(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (isAdminOf(resource.data)
          || (isMemberOf(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())));
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // Asking to join: only for yourself, and only with an invite that's turned on for this playgroup.
      // You and the playgroup's admins can see the request; either can withdraw or decline it.
      match /requests/{uid} {
        allow read, delete: if me(uid) || isAdminOf(groupAt(gid));
        allow create: if me(uid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'code', 'photo', 'token', 'at'])
          && request.resource.data.uid == uid
          && request.resource.data.token is string
          && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.gid == gid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.on == true;
        allow update: if false;
      }
    }

    // Invite codes: anyone signed in can open one by its code (to see the playgroup's name), nobody can list them,
    // and only the playgroup's admins can make, change or remove them.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if token.matches('^[A-Z0-9]{10}$')
        && request.resource.data.keys().hasOnly(['gid', 'name', 'byName', 'on', 'createdAt'])
        && isAdminOf(groupAfter(request.resource.data.gid));
      allow update: if request.resource.data.keys().hasOnly(['gid', 'name', 'byName', 'on', 'createdAt'])
        && request.resource.data.gid == resource.data.gid
        && isAdminOf(groupAfter(resource.data.gid));
      allow delete: if isAdminOf(groupAt(resource.data.gid));
    }
  }
}
